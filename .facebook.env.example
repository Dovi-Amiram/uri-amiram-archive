# Optional: lets update-palindromes log in to Facebook by itself when the saved session expires.
# Copy to .facebook.env (git-ignored), fill in, and restrict it:  chmod 600 .facebook.env
# If Facebook asks for a security check or 2FA code, the script stops and asks you to run
# `update-palindromes --login` instead.
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=
